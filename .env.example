# Smoke Strategy Lab research server config
# Research mode only. Do not put exchange keys here.

SMOKE_RESEARCH_MODE=research
SMOKE_RESEARCH_HOST=127.0.0.1
SMOKE_RESEARCH_PORT=8080
SMOKE_RESEARCH_BASE_DIR=/opt/smoke-strategy

# Optional local paths used by scripts/server requests
SMOKE_DEFAULT_RESULTS_DIR=results
SMOKE_DEFAULT_TRADE_CSV=data/sample_runner_trades.csv
SMOKE_DEFAULT_CANDLES_CSV=data/candles.csv

# Optional server auth token.
# If empty or unset, local research server endpoints stay open.
# If set, all non-/health endpoints require X-Research-Token.
RESEARCH_SERVER_TOKEN=

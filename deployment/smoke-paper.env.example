# Smoke Strategy paper-review server config
# Paper-only: no exchange API keys, no order execution.

SMOKE_HOST=0.0.0.0
SMOKE_PORT=8095

# Change this before exposing the server.
SMOKE_PAPER_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Runtime files
SMOKE_RUNTIME_DIR=/opt/smoke-strategy/runtime/paper_review
SMOKE_DB_PATH=/opt/smoke-strategy/runtime/paper_review/paper_review.sqlite3

# Auto scanner: public Binance candles only, virtual paper trades only.
SMOKE_AUTO_SCAN=true
SMOKE_SCAN_INTERVAL_SEC=900
SMOKE_CANDLE_LIMIT=1200
SMOKE_BINANCE_SLEEP_SEC=0.03

# Symbols. If SMOKE_SYMBOLS_FILE exists, it is used instead of SMOKE_SYMBOLS.
SMOKE_SYMBOLS_FILE=/opt/smoke-strategy/results/strategy_universe_layer/combined_symbols.txt
SMOKE_SYMBOLS=INJUSDT,TONUSDT,DOGEUSDT,ARBUSDT,NEARUSDT,OPUSDT

# Paper-review safety rules
SMOKE_DAILY_DD_STOP_PCT=2.0
SMOKE_WEEKLY_DD_STOP_PCT=5.0
SMOKE_MAX_STOP_STREAK=3
SMOKE_MAX_OPEN_PER_SYMBOL=1

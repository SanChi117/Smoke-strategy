[Unit]
Description=SMOKE Paper Control Server + Terminal V3
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smoke
Group=smoke
WorkingDirectory=/opt/smoke-strategy
EnvironmentFile=/opt/smoke-strategy/.env.smoke
ExecStart=/opt/smoke-strategy/.venv/bin/python /opt/smoke-strategy/scripts/smoke_control_server_v3.py
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/smoke-strategy/runtime /opt/smoke-strategy/results

[Install]
WantedBy=multi-user.target

# SMOKE paper control server. No exchange keys. No real orders.
SMOKE_PROJECT_ID=smoke
SMOKE_PROJECT_NAME=SMOKE Strategy
SMOKE_HOST=127.0.0.1
SMOKE_PORT=8095
SMOKE_ADMIN_USER=smoke
SMOKE_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
SMOKE_API_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
SMOKE_RUNTIME_DIR=/opt/smoke-strategy/runtime/smoke_control
SMOKE_DB_PATH=/opt/smoke-strategy/runtime/smoke_control/smoke.sqlite3
SMOKE_AUTO_SCAN=true
SMOKE_AUTO_BOOTSTRAP_HISTORY=true
SMOKE_INTERVAL=15m
SMOKE_BOOTSTRAP_LIMIT=1200
SMOKE_HISTORY_BARS=1200
SMOKE_POLL_SECONDS=30
SMOKE_MAX_SYMBOLS=150
SMOKE_SYMBOLS_FILE=/opt/smoke-strategy/results/strategy_universe_layer/combined_symbols.txt
SMOKE_SYMBOLS=INJUSDT,TONUSDT,DOGEUSDT,ARBUSDT,NEARUSDT,OPUSDT
SMOKE_DAILY_DD_STOP_PCT=2.0
SMOKE_WEEKLY_DD_STOP_PCT=5.0
SMOKE_MAX_STOP_STREAK=3
SMOKE_MAX_OPEN_PER_SYMBOL=1
SMOKE_MAX_OPEN_TOTAL=2
